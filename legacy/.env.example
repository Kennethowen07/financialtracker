# Salin file ini menjadi .env lalu isi nilainya.

# Token bot dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# ID Telegram yang boleh memakai bot (pisahkan dengan koma).
# Kosongkan dulu: kirim /start ke bot, bot akan membalas dengan ID kamu.
ALLOWED_USER_IDS=

# API key dari https://platform.claude.com (Settings → API Keys).
# Kalau kosong, aplikasi tetap jalan memakai parser lokal (tanpa AI).
ANTHROPIC_API_KEY=

# Model Claude. Default: claude-opus-5-5.
# Alternatif lebih murah untuk pencatatan sederhana: claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

TIMEZONE=Asia/Jakarta

# Dashboard web
PORT=3000
HOST=127.0.0.1
# Isi kalau dashboard dibuka dari internet (login: username bebas, password ini)
DASHBOARD_PASSWORD=
# Link yang dikirim bot saat /dashboard (opsional)
DASHBOARD_URL=

# Lokasi database (opsional, default: data/finance.db)
# DB_PATH=
