# Salin file ini menjadi .env.local lalu isi nilainya. File .env.local tidak ikut git.
# Di Vercel, isi nilai yang sama di Settings → Environment Variables.

# --- Database (Turso) ---
# Kosongkan saat development: aplikasi otomatis memakai file local.db.
# Production: buat database di https://turso.tech lalu isi dua nilai ini.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- AI (Gemini, mode gratis) ---
# Ambil di https://aistudio.google.com/apikey
# Kalau kosong, aplikasi tetap jalan: input yang tidak ada di memori langsung tanya balik.
GEMINI_API_KEY=
# Opsional. Default gemini-flash-latest.
GEMINI_MODEL=

# --- Login (Google) ---
# Buat "OAuth Client ID" di Google Cloud Console (redirect URI: <alamat>/api/auth/google/callback).
# Kalau kosong saat development, pakai login developer di halaman /masuk (tanpa Google).
# Login developer hanya ada kalau TURSO_DATABASE_URL kosong (database file local.db).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email Google pemilik aplikasi. Akun ini jadi admin dan menerima data lama (sebelum ada akun).
ADMIN_EMAIL=
# Kunci tanda tangan cookie sesi (string acak panjang). Wajib di production. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Batas panggilan AI per akun per hari untuk akun biasa (default 30). Admin tidak dibatasi.
AI_BATAS_PENGGUNA=

# --- Mode demo ---
# Batas total panggilan AI per hari untuk semua pengunjung demo (default 100).
DEMO_BATAS_HARIAN=
