# Salin file ini menjadi .env.local lalu isi nilainya. File .env.local tidak ikut git.
# Di Vercel, isi nilai yang sama di Settings → Environment Variables.

# --- Database (Turso) ---
# Kosongkan saat development: aplikasi otomatis memakai file local.db.
# Production: buat database di https://turso.tech lalu isi dua nilai ini.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- AI (Gemini, mode gratis) ---
# Ambil di https://aistudio.google.com/apikey
# Kalau kosong, aplikasi tetap jalan: input yang tidak ada di memori langsung tanya balik.
GEMINI_API_KEY=
# Opsional. Default gemini-flash-latest.
GEMINI_MODEL=

# --- Login akun pribadi ---
# Wajib di production. Kalau kosong saat development, login dilewati.
APP_PASSWORD=
# Kunci tanda tangan cookie sesi (string acak panjang). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Mode demo ---
# Batas total panggilan AI per hari untuk semua pengunjung demo (default 100).
DEMO_BATAS_HARIAN=
